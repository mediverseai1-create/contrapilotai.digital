# Supabase — from your Supabase project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# AI provider — Google AI Studio (Gemini) API key, server-only
GEMINI_API_KEY=

# Payment links — your existing hosted payment links (e.g. Stripe Payment Links, Paddle, Lemon Squeezy)
NEXT_PUBLIC_TEAM_PAYMENT_LINK=
NEXT_PUBLIC_BUSINESS_PAYMENT_LINK=
NEXT_PUBLIC_FIRM_PAYMENT_LINK=

# Base URL of the deployed app (used for password reset redirects, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
